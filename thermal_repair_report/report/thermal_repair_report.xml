<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =====================================================================
             Report Action - single "Thermal Repair Order" action, 80mm.
             ===================================================================== -->

        <record id="action_report_thermal_repair_order" model="ir.actions.report">
            <field name="name">Thermal Repair Order</field>
            <field name="model">repair.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">thermal_repair_report.report_thermal_repair</field>
            <field name="report_file">thermal_repair_report.report_thermal_repair</field>
            <field name="print_report_name">'Repair Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="repair.model_repair_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="thermal_sale_report.paperformat_thermal_paper_80mm"/>
        </record>

        <!-- =====================================================================
             QWeb Template - same POS-receipt design language as
             thermal_sale_report/report/thermal_report.xml (identical CSS,
             identical structure/order). Do not edit this <style> block
             without mirroring the change back into thermal_report.xml.
             ===================================================================== -->

        <template id="report_thermal_repair">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="cur" t-value="doc.currency_id.name or doc.currency_id.symbol"/>
                    <t t-set="is_arabic" t-value="doc.partner_id.lang and 'ar' in doc.partner_id.lang"/>
                    <t t-set="doc_dir" t-value="'rtl' if is_arabic else 'ltr'"/>

                    <style type="text/css">
                        .thermal-doc {
                            font-family: 'Courier New', Courier, monospace !important;
                            font-size: 13px !important;
                            line-height: 1.4 !important;
                            color: #000000 !important;
                            width: 100% !important;
                            margin: 0 !important;
                            padding: 0 !important;
                        }
                        .thermal-doc[dir="rtl"] { text-align: right !important; direction: rtl !important; }
                        .thermal-doc[dir="ltr"] { text-align: left !important; direction: ltr !important; }

                        .rc-center { text-align: center !important; }
                        .rc-bold { font-weight: bold !important; }
                        .rc-small { font-size: 11px !important; }

                        .rc-logo { max-width: 60% !important; max-height: 18mm !important; display: block !important; margin: 0 auto 1mm auto !important; }
                        .rc-company-name { font-size: 17px !important; font-weight: bold !important; text-align: center !important; margin: 0 0 1mm 0 !important; }
                        .rc-title { text-align: center !important; font-weight: bold !important; margin: 1mm 0 !important; }

                        .rc-dash { margin: 0.8mm 0 !important; letter-spacing: -0.5px !important; }

                        .rc-row { width: 100% !important; overflow: hidden !important; }
                        .thermal-doc[dir="ltr"] .rc-row-amt { float: right !important; }
                        .thermal-doc[dir="rtl"] .rc-row-amt { float: left !important; }

                        .rc-pad { padding-left: 8px !important; }
                        .thermal-doc[dir="rtl"] .rc-pad { padding-left: 0 !important; padding-right: 8px !important; }

                        .rc-total-row { font-weight: bold !important; font-size: 15px !important; }
                        .rc-spacer { height: 3mm !important; }
                        .rc-end-space { height: 10mm !important; }
                    </style>

                    <div class="thermal-doc" t-att-dir="doc_dir">

                        <!-- ===== Header : logo or company name ===== -->
                        <t t-if="doc.company_id.logo">
                            <img t-att-src="image_data_uri(doc.company_id.logo)" class="rc-logo" alt="Logo"/>
                        </t>
                        <t t-else="">
                            <div class="rc-company-name"><t t-esc="doc.company_id.name"/></div>
                        </t>

                        <!-- ===== Title ===== -->
                        <div class="rc-title">
                            <span t-if="is_arabic">أمر صيانة</span>
                            <span t-else="">Repair Order</span>
                        </div>

                        <!-- ===== Contact block ===== -->
                        <div class="rc-center">
                            <div t-if="doc.company_id.city or doc.company_id.state_id or doc.company_id.country_id">
                                <t t-if="doc.company_id.city"><t t-esc="doc.company_id.city"/></t>
                                <t t-if="doc.company_id.state_id"><t t-if="doc.company_id.city">, </t><t t-esc="doc.company_id.state_id.name"/></t>
                                <t t-if="doc.company_id.country_id"><t t-if="doc.company_id.city or doc.company_id.state_id">, </t><t t-esc="doc.company_id.country_id.name"/></t>
                            </div>
                            <div t-if="doc.company_id.phone">Tel: <t t-esc="doc.company_id.phone"/></div>
                            <div t-if="doc.company_id.vat"><t t-esc="doc.company_id.account_fiscal_country_id.vat_label or 'VAT'"/>: <t t-esc="doc.company_id.vat"/></div>
                            <div t-if="doc.company_id.email"><t t-esc="doc.company_id.email"/></div>
                            <div t-if="doc.company_id.website"><t t-esc="doc.company_id.website"/></div>
                        </div>

                        <!-- ===== Client block ===== -->
                        <t t-if="doc.partner_id">
                            <div class="rc-dash">--------------------------------</div>
                            <div><span t-if="is_arabic">العميل: </span><span t-else="">Client: </span><t t-esc="doc.partner_id.name"/></div>
                            <div t-if="doc.partner_id.phone"><span t-if="is_arabic">هاتف: </span><span t-else="">Tel: </span><t t-esc="doc.partner_id.phone"/></div>
                            <div t-if="doc.partner_id.vat"><span t-if="is_arabic">الرقم الضريبي: </span><span t-else="">Tax ID: </span><t t-esc="doc.partner_id.vat"/></div>
                        </t>

                        <!-- ===== Product / Serial being repaired ===== -->
                        <t t-if="doc.product_id">
                            <div class="rc-dash">--------------------------------</div>
                            <div class="rc-pad">
                                <span t-if="is_arabic">المنتج: </span><span t-else="">Product: </span>
                                <t t-esc="doc.product_id.name"/>
                                <t t-if="doc.product_id.default_code"> [<t t-esc="doc.product_id.default_code"/>]</t>
                            </div>
                            <div class="rc-pad" t-if="doc.lot_id"><span t-if="is_arabic">الرقم التسلسلي: </span><span t-else="">Serial/Lot: </span><t t-esc="doc.lot_id.name"/></div>
                        </t>

                        <!-- ===== Responsible ===== -->
                        <t t-if="doc.user_id">
                            <div class="rc-dash">--------------------------------</div>
                            <div class="rc-pad"><span t-if="is_arabic">المسؤول: </span><span t-else="">Responsible: </span><t t-esc="doc.user_id.name"/></div>
                        </t>
                        <div class="rc-dash">--------------------------------</div>

                        <!-- ===== Repair description ===== -->
                        <t t-if="doc.description">
                            <div class="rc-pad rc-small">
                                <span t-if="is_arabic">وصف الصيانة: </span><span t-else="">Repair Description: </span><t t-esc="doc.description"/>
                            </div>
                            <div class="rc-dash">--------------------------------</div>
                        </t>

                        <div class="rc-spacer"/>

                        <!-- ===== Parts ===== -->
                        <t t-if="doc.operations">
                            <div class="rc-bold"><span t-if="is_arabic">القطع</span><span t-else="">Parts</span></div>
                            <t t-foreach="doc.operations" t-as="line">
                                <div>
                                    <t t-if="line.type == 'remove'">(<span t-if="is_arabic">إزالة</span><span t-else="">Remove</span>) </t>
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </div>
                                <div class="rc-row rc-pad">
                                    <span t-field="line.product_uom_qty"/>
                                    <t groups="uom.group_uom"> <t t-esc="line.product_uom.name"/></t>
                                    <span class="rc-row-amt">
                                        <t t-if="doc.invoice_method != 'none'"><t t-esc="'{:,.2f} {}'.format(line.price_subtotal, cur)"/></t>
                                    </span>
                                </div>
                                <div class="rc-pad rc-small" t-if="line.lot_id">SN: <span class="rc-bold" t-esc="line.lot_id.name"/></div>
                            </t>
                            <div class="rc-dash rc-center">--------</div>
                        </t>

                        <!-- ===== Operations / Labor ===== -->
                        <t t-if="doc.fees_lines">
                            <div class="rc-bold"><span t-if="is_arabic">أعمال الصيانة</span><span t-else="">Operations</span></div>
                            <t t-foreach="doc.fees_lines" t-as="fee">
                                <div><span t-field="fee.name" t-options="{'widget': 'text'}"/></div>
                                <div class="rc-row rc-pad">
                                    <span t-field="fee.product_uom_qty"/>
                                    <t groups="uom.group_uom"> <t t-esc="fee.product_uom.name"/></t>
                                    <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(fee.price_subtotal, cur)"/></span>
                                </div>
                            </t>
                            <div class="rc-dash rc-center">--------</div>
                        </t>

                        <!-- ===== Financial summary (only when meant to be invoiced) ===== -->
                        <t t-if="doc.invoice_method != 'none'">
                            <t t-if="doc.operations">
                                <div class="rc-row">
                                    <span t-if="is_arabic">مجموع القطع</span><span t-else="">Parts Subtotal</span>
                                    <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(sum(doc.operations.mapped('price_subtotal')), cur)"/></span>
                                </div>
                            </t>
                            <t t-if="doc.fees_lines">
                                <div class="rc-row">
                                    <span t-if="is_arabic">أعمال الصيانة</span><span t-else="">Operations / Labor</span>
                                    <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(sum(doc.fees_lines.mapped('price_subtotal')), cur)"/></span>
                                </div>
                            </t>
                            <div class="rc-row">
                                <span t-if="is_arabic">المجموع غير شامل الضريبة</span><span t-else="">Subtotal</span>
                                <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(doc.amount_untaxed, cur)"/></span>
                            </div>
                            <div class="rc-row">
                                <span t-if="is_arabic">الضريبة</span><span t-else="">Taxes</span>
                                <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(doc.amount_tax, cur)"/></span>
                            </div>

                            <div class="rc-row rc-center rc-dash">--------</div>
                            <div class="rc-row rc-total-row">
                                <span t-if="is_arabic">المجموع الكلي</span><span t-else="">TOTAL</span>
                                <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(doc.amount_total, cur)"/></span>
                            </div>

                            <div class="rc-spacer"/>
                        </t>

                        <!-- ===== Repair status ===== -->
                        <div class="rc-row">
                            <span t-if="is_arabic">حالة الطلب</span><span t-else="">Repair Status</span>
                            <span class="rc-row-amt" t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state)"/>
                        </div>

                        <div class="rc-spacer"/>

                        <!-- ===== Footer thank-you ===== -->
                        <div class="rc-center rc-bold">
                            <span t-if="is_arabic">شكراً لزيارتكم!</span>
                            <span t-else="">Thank You For Your Business!</span>
                        </div>

                        <!-- ===== Additional Details ===== -->
                        <div class="rc-dash rc-center">--------------------------------</div>
                        <div class="rc-pad rc-small">
                            <span t-if="is_arabic">تفاصيل إضافية:</span><span t-else="">Additional Details:</span><br/>
                            <span t-if="is_arabic">- يقر المستلم بأن البضاعة استُلمت بحالة جيدة</span>
                            <span t-else="">- Retailer acknowledges that the goods are received in good condition</span><br/>
                            <span t-if="is_arabic">- ضمان الشركة المصنعة حسب الشروط من تاريخ الفاتورة</span>
                            <span t-else="">- Manufacturer warranty as per terms from invoice date</span><br/>
                            <span t-if="is_arabic">- في حال الجوال، الضمان مشمول من الشركة المصنعة</span>
                            <span t-else="">- In case of mobile, warranty will be covered by the manufacturer</span><br/>
                        </div>
                        <div class="rc-dash rc-center">--------------------------------</div>

                        <!-- ===== Order reference + date (very bottom) ===== -->
                        <div class="rc-spacer"/>
                        <div class="rc-center"><t t-esc="doc.name"/></div>
                        <div class="rc-center" t-if="doc.create_date"><span t-field="doc.create_date" t-options="{'widget': 'date'}"/></div>

                        <div class="rc-end-space"/>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
