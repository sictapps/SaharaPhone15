<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_report_print_thermal_so" model="ir.actions.report">
            <field name="name">Thermal Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">thermal_sale_report.report_thermal</field>
            <field name="report_file">thermal_sale_report.report_thermal</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_thermal_paper_80mm"/>
        </record>

        <!-- =====================================================================
             QWeb Template - mirrors the actual POS receipt (point_of_sale
             core OrderReceipt.xml + the custom_pos_receipt module's xpath
             additions: "Tax Invoice" title, Client/Tel/Tax ID block,
             SalesPerson line, "Additional Details" warranty text) as closely
             as a backend qweb-pdf report can: monospace font, plain-text
             dashed-line separators (no boxes/colors/grid borders), prices
             right-floated, order reference + date printed at the very
             bottom - same structure/order as the POS ticket.
             ===================================================================== -->

        <template id="report_thermal">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="cur" t-value="doc.currency_id.name or doc.currency_id.symbol"/>
                    <t t-set="is_arabic" t-value="doc.partner_id.lang and 'ar' in doc.partner_id.lang"/>
                    <t t-set="doc_dir" t-value="'rtl' if is_arabic else 'ltr'"/>

                    <style type="text/css">
                        .thermal-doc {
                            font-family: 'Courier New', Courier, monospace !important;
                            font-size: 13px !important;
                            line-height: 1.4 !important;
                            color: #000000 !important;
                            width: 100% !important;
                            margin: 0 !important;
                            padding: 0 !important;
                        }
                        .thermal-doc[dir="rtl"] { text-align: right !important; direction: rtl !important; }
                        .thermal-doc[dir="ltr"] { text-align: left !important; direction: ltr !important; }

                        .rc-center { text-align: center !important; }
                        .rc-bold { font-weight: bold !important; }
                        .rc-small { font-size: 11px !important; }

                        .rc-logo { max-width: 60% !important; max-height: 18mm !important; display: block !important; margin: 0 auto 1mm auto !important; }
                        .rc-company-name { font-size: 17px !important; font-weight: bold !important; text-align: center !important; margin: 0 0 1mm 0 !important; }
                        .rc-title { text-align: center !important; font-weight: bold !important; margin: 1mm 0 !important; }

                        .rc-dash { margin: 0.8mm 0 !important; letter-spacing: -0.5px !important; }

                        .rc-row { width: 100% !important; overflow: hidden !important; }
                        .thermal-doc[dir="ltr"] .rc-row-amt { float: right !important; }
                        .thermal-doc[dir="rtl"] .rc-row-amt { float: left !important; }

                        .rc-pad { padding-left: 8px !important; }
                        .thermal-doc[dir="rtl"] .rc-pad { padding-left: 0 !important; padding-right: 8px !important; }

                        .rc-total-row { font-weight: bold !important; font-size: 15px !important; }
                        .rc-spacer { height: 3mm !important; }
                        .rc-end-space { height: 10mm !important; }
                    </style>

                    <div class="thermal-doc" t-att-dir="doc_dir">

                        <!-- ===== Header : logo or company name ===== -->
                        <t t-if="doc.company_id.logo">
                            <img t-att-src="image_data_uri(doc.company_id.logo)" class="rc-logo" alt="Logo"/>
                        </t>
                        <t t-else="">
                            <div class="rc-company-name"><t t-esc="doc.company_id.name"/></div>
                        </t>

                        <!-- ===== "Tax Invoice" title (matches custom_pos_receipt xpath) ===== -->
                        <div class="rc-title">
                            <span t-if="is_arabic">فاتورة ضريبية</span>
                            <span t-else="">Tax Invoice</span>
                        </div>

                        <!-- ===== Contact block ===== -->
                        <div class="rc-center">
                            <div t-if="doc.company_id.city or doc.company_id.state_id or doc.company_id.country_id">
                                <t t-if="doc.company_id.city"><t t-esc="doc.company_id.city"/></t>
                                <t t-if="doc.company_id.state_id"><t t-if="doc.company_id.city">, </t><t t-esc="doc.company_id.state_id.name"/></t>
                                <t t-if="doc.company_id.country_id"><t t-if="doc.company_id.city or doc.company_id.state_id">, </t><t t-esc="doc.company_id.country_id.name"/></t>
                            </div>
                            <div t-if="doc.company_id.phone">Tel: <t t-esc="doc.company_id.phone"/></div>
                            <div t-if="doc.company_id.vat"><t t-esc="doc.company_id.account_fiscal_country_id.vat_label or 'VAT'"/>: <t t-esc="doc.company_id.vat"/></div>
                            <div t-if="doc.company_id.email"><t t-esc="doc.company_id.email"/></div>
                            <div t-if="doc.company_id.website"><t t-esc="doc.company_id.website"/></div>
                        </div>

                        <!-- ===== Client block (matches custom_pos_receipt xpath) ===== -->
                        <t t-if="doc.partner_id">
                            <div class="rc-dash">--------------------------------</div>
                            <div><span t-if="is_arabic">العميل: </span><span t-else="">Client: </span><t t-esc="doc.partner_id.name"/></div>
                            <div t-if="doc.partner_id.phone"><span t-if="is_arabic">هاتف: </span><span t-else="">Tel: </span><t t-esc="doc.partner_id.phone"/></div>
                            <div t-if="doc.partner_id.vat"><span t-if="is_arabic">الرقم الضريبي: </span><span t-else="">Tax ID: </span><t t-esc="doc.partner_id.vat"/></div>
                        </t>

                        <!-- ===== Salesperson (matches custom_pos_receipt xpath) ===== -->
                        <t t-if="doc.invoice_user_id">
                            <div class="rc-dash">--------------------------------</div>
                            <div class="rc-pad"><span t-if="is_arabic">البائع: </span><span t-else="">SalesPerson: </span><t t-esc="doc.invoice_user_id.name"/></div>
                        </t>
                        <div class="rc-dash">--------------------------------</div>

                        <div class="rc-spacer"/>

                        <!-- ===== Order lines ===== -->
                        <t t-foreach="doc.invoice_line_ids" t-as="line">
                            <t t-if="line.display_type == 'line_section'">
                                <div class="rc-bold"><span t-field="line.name" t-options="{'widget': 'text'}"/></div>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <div class="rc-small"><span t-field="line.name" t-options="{'widget': 'text'}"/></div>
                            </t>
                            <t t-else="">
                                <div>
                                    <t t-if="line.product_id.default_code">[<t t-esc="line.product_id.default_code"/>] </t>
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </div>
                                <t t-if="line.discount">
                                    <div class="rc-pad"><span t-if="is_arabic">خصم: </span><span t-else="">Discount: </span><t t-esc="'%.2f' % line.discount"/>%</div>
                                </t>
                                <div class="rc-row rc-pad">
                                    <t t-esc="line.quantity"/>
                                    <t groups="uom.group_uom"> <t t-esc="line.product_uom_id.name"/></t>
                                    x <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                    <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(line.price_subtotal, cur)"/></span>
                                </div>
                                <t t-if="line.tax_ids">
                                    <div class="rc-pad rc-small"><span t-if="is_arabic">الضريبة: </span><span t-else="">Tax: </span><t t-esc="', '.join(line.tax_ids.mapped('name'))"/></div>
                                </t>
                                <t t-set="sn_list" t-value="', '.join([l['lot_name'] for l in doc.get_line_lots(line) if l.get('lot_name')])"/>
                                <t t-if="sn_list">
                                    <div class="rc-pad rc-small">SN: <span class="rc-bold" t-esc="sn_list"/></div>
                                </t>
                            </t>
                        </t>

                        <!-- ===== Subtotal + tax breakdown ===== -->
                        <div class="rc-row rc-center rc-dash">--------</div>
                        <t t-set="tax_totals" t-value="json.loads(doc.tax_totals_json)"/>
                        <div class="rc-row">
                            <span t-if="is_arabic">المجموع غير شامل الضريبة</span><span t-else="">Subtotal</span>
                            <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(tax_totals['amount_untaxed'], cur)"/></span>
                        </div>
                        <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                            <t t-foreach="tax_totals.get('groups_by_subtotal', {}).get(subtotal['name'], [])" t-as="grp">
                                <div class="rc-row">
                                    <t t-esc="grp['tax_group_name']"/>
                                    <span class="rc-row-amt"><t t-esc="'{:,.2f}'.format(grp['tax_group_amount'])"/></span>
                                </div>
                            </t>
                        </t>

                        <!-- ===== Total ===== -->
                        <div class="rc-row rc-center rc-dash">--------</div>
                        <div class="rc-row rc-total-row">
                            <span t-if="is_arabic">المجموع الكلي</span><span t-else="">TOTAL</span>
                            <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(tax_totals['amount_total'], cur)"/></span>
                        </div>

                        <div class="rc-spacer"/>

                        <!-- ===== Payment info (posted customer invoices/credit notes only) ===== -->
                        <t t-if="doc.move_type in ('out_invoice', 'out_refund') and doc.state == 'posted'">
                            <div class="rc-row">
                                <span t-if="is_arabic">حالة الدفع</span><span t-else="">Payment Status</span>
                                <span class="rc-row-amt" t-esc="dict(doc._fields['payment_state'].selection).get(doc.payment_state, doc.payment_state)"/>
                            </div>
                            <div class="rc-row">
                                <span t-if="is_arabic">المبلغ المتبقي</span><span t-else="">Amount Due</span>
                                <span class="rc-row-amt"><t t-esc="'{:,.2f} {}'.format(doc.amount_residual, cur)"/></span>
                            </div>
                            <div class="rc-spacer"/>
                        </t>

                        <!-- ===== Footer thank-you ===== -->
                        <div class="rc-center rc-bold">
                            <span t-if="is_arabic">شكراً لزيارتكم!</span>
                            <span t-else="">Thank You For Your Business!</span>
                        </div>

                        <!-- ===== Additional Details (matches custom_pos_receipt xpath) ===== -->
                        <div class="rc-dash rc-center">--------------------------------</div>
                        <div class="rc-pad rc-small">
                            <span t-if="is_arabic">تفاصيل إضافية:</span><span t-else="">Additional Details:</span><br/>
                            <span t-if="is_arabic">- يقر المستلم بأن البضاعة استُلمت بحالة جيدة</span>
                            <span t-else="">- Retailer acknowledges that the goods are received in good condition</span><br/>
                            <span t-if="is_arabic">- ضمان الشركة المصنعة حسب الشروط من تاريخ الفاتورة</span>
                            <span t-else="">- Manufacturer warranty as per terms from invoice date</span><br/>
                            <span t-if="is_arabic">- في حال الجوال، الضمان مشمول من الشركة المصنعة</span>
                            <span t-else="">- In case of mobile, warranty will be covered by the manufacturer</span><br/>
                        </div>
                        <div class="rc-dash rc-center">--------------------------------</div>

                        <!-- ===== Order reference + date (very bottom, matches receipt.name/date) ===== -->
                        <div class="rc-spacer"/>
                        <div class="rc-center"><t t-esc="doc.name"/></div>
                        <div class="rc-center" t-if="doc.invoice_date"><span t-field="doc.invoice_date"/></div>

                        <div class="rc-end-space"/>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
